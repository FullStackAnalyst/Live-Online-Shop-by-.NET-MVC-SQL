@functions {
    string Img(string file) => Url.Content($"~/img/blog/{file}");
}

<div class="blog_comment_form">
    <div class="container">
        <div class="row">
            <div class="col-12">

                <!-- Existing Comments -->
                <div class="comments_box">
                    <h3>02 Comments</h3>

                    <div class="comment_list d-flex">
                        <div class="comment_thumb">
                            <img src="@Img("post-comment1.png")" alt="" />
                        </div>
                        <div class="comment_content border-top">
                            <div class="comment_meta d-flex align-items-center">
                                <h5><a href="#">Justin Bieber</a></h5>
                                <span> - Aug 26 2020 at 15 hours ago</span>
                            </div>
                            <p>
                                Comment example here. Nulla risus lacus, vehicula id mi
                                vitae, auctor accumsan nulla. Sed a dolor sit amrt paremi
                                quam. terdum.
                            </p>
                            <div class="comment_reply">
                                <a href="#">Reply</a>
                            </div>
                        </div>
                    </div>

                    <div class="comment_list d-flex">
                        <div class="comment_thumb">
                            <img src="@Img("post-comment2.png")" alt="" />
                        </div>
                        <div class="comment_content border-top">
                            <div class="comment_meta d-flex align-items-center">
                                <h5><a href="#">Selena Gomes</a></h5>
                                <span> - Aug 26 2020 at 15 hours ago</span>
                            </div>
                            <p>
                                Comment example here. Nulla risus lacus, vehicula id mi
                                vitae, auctor accumsan nulla. Sed a dolor sit amrt paremi
                                quam. terdum.
                            </p>
                            <div class="comment_reply">
                                <a href="#">Reply</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Comment Form -->
                <div class="comments_form">
                    <h3>Leave a comment</h3>
                    <form action="#">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <input placeholder="Name *" type="text" />
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <input placeholder="Email *" type="text" />
                            </div>
                            <div class="col-12">
                                <input placeholder="Subject (optional)" type="text" />
                            </div>
                            <div class="col-12">
                                <textarea placeholder="Message"></textarea>
                            </div>
                        </div>
                        <button class="btn btn-primary" type="submit">Post Comment</button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>