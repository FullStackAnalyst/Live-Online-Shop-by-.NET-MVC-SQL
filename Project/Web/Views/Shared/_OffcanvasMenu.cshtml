@using Web.Models
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLowerInvariant();
    var topMenus = ViewData["TopMenus"] as List<Menu> ?? new List<Menu>();
    var subMenus = ViewData["SubMenus"] as List<Menu> ?? new List<Menu>();
}

<div class="offcanvas_menu">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="offcanvas_menu_wrapper">
                    <!-- Close Button -->
                    <div class="canvas_close">
                        <a href="javascript:void(0)"><i class="ion-android-close"></i></a>
                    </div>

                    <!-- Contact Info -->
                    <div class="header_contact_info">
                        <ul class="d-flex">
                            <li class="text-white">
                                <i class="icons icon-phone"></i>
                                <a href="tel:+05483716566">+054 8371 65 66</a>
                            </li>
                            <li class="text-white">
                                <i class="icon-envelope-letter icons"></i>
                                <a href="mailto:uthrstore@domain.com">uthrstore@domain.com</a>
                            </li>
                        </ul>
                    </div>

                    <!-- Social Links -->
                    <div class="header_social d-flex">
                        <span>Follow us</span>
                        <ul class="d-flex">
                            <li><a href="#"><i class="icon-social-twitter icons"></i></a></li>
                            <li><a href="#"><i class="icon-social-facebook icons"></i></a></li>
                            <li><a href="#"><i class="icon-social-instagram icons"></i></a></li>
                            <li><a href="#"><i class="icon-social-youtube icons"></i></a></li>
                            <li><a href="#"><i class="icon-social-pinterest icons"></i></a></li>
                        </ul>
                    </div>

                    <!-- Language & Currency -->
                    <div class="language_currency">
                        <ul class="d-flex">
                            <li class="language">
                                <a href="#">Eng <i class="icon-right ion-ios-arrow-down"></i></a>
                                <ul class="dropdown_language">
                                    <li><a href="#">French</a></li>
                                    <li><a href="#">Spanish</a></li>
                                    <li><a href="#">Russian</a></li>
                                </ul>
                            </li>
                            <li class="currency">
                                <a href="#">USD <i class="icon-right ion-ios-arrow-down"></i></a>
                                <ul class="dropdown_currency">
                                    <li><a href="#">€ Euro</a></li>
                                    <li><a href="#">£ Pound Sterling</a></li>
                                    <li><a href="#">$ US Dollar</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>

                    <!-- Navigation Menu -->
                    <div id="menu" class="text-left">
                        <ul class="offcanvas_main_menu">
                            @foreach (var menu in topMenus)
                            {
                                var linkParts = menu.Link?.TrimStart('/').Split('/');
                                var menuController = linkParts?.Length > 0 ? linkParts[0].ToLowerInvariant() : "";
                                var menuAction = linkParts?.Length > 1 ? linkParts[1].ToLowerInvariant() : "";
                                var isActive = currentController == menuController && currentAction == menuAction;

                                var hasSubMenu = subMenus.Any(s => s.Title?.Contains(menu.Title ?? "", StringComparison.OrdinalIgnoreCase) == true);

                                <li class="@(hasSubMenu ? "menu-item-has-children" : "")">
                                    <a class="@(isActive ? "active" : "")" href="@menu.Link">@menu.Title</a>
                                    @if (hasSubMenu)
                                    {
                                        <ul class="sub-menu">
                                            @foreach (var subMenu in subMenus.Where(s => s.Title?.Contains(menu.Title ?? "", StringComparison.OrdinalIgnoreCase) == true))
                                            {
                                                <li><a href="@subMenu.Link">@subMenu.Title</a></li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>