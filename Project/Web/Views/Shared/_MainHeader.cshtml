@using Web.Models
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLowerInvariant();
    var topMenus = ViewData["TopMenus"] as List<Menu> ?? new List<Menu>();
    var subMenus = ViewData["SubMenus"] as List<Menu> ?? new List<Menu>();
    var accountMenus = ViewData["AccountMenus"] as List<Menu> ?? new List<Menu>();
}

<div class="main_header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="header_container d-flex justify-content-between align-items-center">

                    <!-- Mobile Nav -->
                    <div class="canvas_open">
                        <a href="javascript:void(0)"><i class="ion-navicon"></i></a>
                    </div>

                    <!-- Logo -->
                    <div class="header_logo">
                        <a class="sticky_none" asp-controller="Home" asp-action="Index">
                            <img src="~/img/logo/logo.png" alt="Logo" />
                        </a>
                    </div>

                    <!-- Main Menu -->
                    <div class="main_menu d-none d-lg-block">
                        <nav>
                            <ul class="d-flex">
                                @foreach (var menu in topMenus)
                                {
                                    var linkParts = menu.Link?.TrimStart('/').Split('/');
                                    var menuController = linkParts?.Length > 0 ? linkParts[0].ToLowerInvariant() : "";
                                    var menuAction = linkParts?.Length > 1 ? linkParts[1].ToLowerInvariant() : "";
                                    var isActive = currentController == menuController && currentAction == menuAction;

                                    var hasSubMenu = subMenus.Any(s => s.Title?.Contains(menu.Title ?? "", StringComparison.OrdinalIgnoreCase) == true);

                                    <li>
                                        <a class="@(isActive ? "active" : "")" href="@menu.Link">@menu.Title</a>
                                        @if (hasSubMenu)
                                        {
                                            <ul class="sub_menu">
                                                @foreach (var subMenu in subMenus.Where(s => s.Title?.Contains(menu.Title ?? "", StringComparison.OrdinalIgnoreCase) == true))
                                                {
                                                    <li><a href="@subMenu.Link">@subMenu.Title</a></li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>

                    <!-- Icons -->
                    <div class="header_account">
                        <ul class="d-flex">
                            <li class="header_search">
                                <a href="#"><i class="icon-magnifier icons"></i></a>
                            </li>
                            <li class="account_link">
                                <a href="#"><i class="icon-user icons"></i></a>
                                <ul class="dropdown_account_link">
                                    @foreach (var accountMenu in accountMenus)
                                    {
                                        <li><a href="@accountMenu.Link">@accountMenu.Title</a></li>
                                    }
                                </ul>
                            </li>
                            <li>
                                <a href="#"><i class="icon-heart icons"></i></a>
                                <span class="item_count">2</span>
                            </li>
                            <li class="shopping_cart">
                                <a href="#"><i class="icon-basket-loaded icons"></i></a>
                                <span class="item_count">2</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>