@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLowerInvariant();
}

<div class="main_header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="header_container d-flex justify-content-between align-items-center">

                    <!-- Mobile Nav -->
                    <div class="canvas_open">
                        <a href="javascript:void(0)"><i class="ion-navicon"></i></a>
                    </div>

                    <!-- Logo -->
                    <div class="header_logo">
                        <a class="sticky_none" asp-controller="Home" asp-action="Index">
                            <img src="~/img/logo/logo.png" alt="Logo" />
                        </a>
                    </div>

                    <!-- Main Menu -->
                    <div class="main_menu d-none d-lg-block">
                        <nav>
                            <ul class="d-flex">
                                <li>
                                    <a class="@(currentController == "home" && currentAction == "index" ? "active" : "")"
                                       asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li>
                                    <a class="@(currentController == "shop" && currentAction == "index" ? "active" : "")"
                                       asp-controller="Shop" asp-action="Index">Shop</a>
                                </li>
                                <li>
                                    <a class="@(currentController == "product" && currentAction == "details" ? "active" : "")"
                                       asp-controller="Product" asp-action="Details">Product</a>
                                </li>
                                <li>
                                    <a class="@(currentController == "blog" && (currentAction == "index" || currentAction == "details") ? "active" : "")"
                                       asp-controller="Blog" asp-action="Index">Blog</a>
                                    <ul class="sub_menu">
                                        <li><a asp-controller="Blog" asp-action="Index">Blog Pages</a></li>
                                        <li><a asp-controller="Blog" asp-action="Details">Blog Details</a></li>
                                    </ul>
                                </li>
                                <li>
                                    <a class="@(currentController == "cart" && currentAction == "index" ? "active" : "")"
                                       asp-controller="Cart" asp-action="Index">Cart</a>
                                </li>
                                <li>
                                    <a class="@(currentController == "checkout" && currentAction == "index" ? "active" : "")"
                                       asp-controller="Checkout" asp-action="Index">Checkout</a>
                                </li>
                            </ul>
                        </nav>
                    </div>

                    <!-- Icons -->
                    <div class="header_account">
                        <ul class="d-flex">
                            <li class="header_search">
                                <a href="#"><i class="icon-magnifier icons"></i></a>
                            </li>
                            <li class="account_link">
                                <a href="#"><i class="icon-user icons"></i></a>
                                <ul class="dropdown_account_link">
                                    <li><a href="#">My Account</a></li>
                                    <li><a href="#">Login</a></li>
                                    <li><a href="#">Contact</a></li>
                                </ul>
                            </li>
                            <li>
                                <a href="#"><i class="icon-heart icons"></i></a>
                                <span class="item_count">2</span>
                            </li>
                            <li class="shopping_cart">
                                <a href="#"><i class="icon-basket-loaded icons"></i></a>
                                <span class="item_count">2</span>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>