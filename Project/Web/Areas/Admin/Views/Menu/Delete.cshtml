@model Web.Models.Menu

@{
    ViewData["Title"] = "Delete Menu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<section class="container py-4">
    <div class="mb-4">
        <h1 class="h4 text-danger fw-bold">@ViewData["Title"]</h1>
        <p class="lead">Are you sure you want to delete this menu item?</p>
        <hr />
    </div>

    <div class="row">
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-4 fw-semibold text-secondary">@Html.DisplayNameFor(model => model.Title)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Title)</dd>

                <dt class="col-sm-4 fw-semibold text-secondary">@Html.DisplayNameFor(model => model.Link)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Link)</dd>

                <dt class="col-sm-4 fw-semibold text-secondary">@Html.DisplayNameFor(model => model.Type)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Type)</dd>
            </dl>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Confirm Delete
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left-circle me-1"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>